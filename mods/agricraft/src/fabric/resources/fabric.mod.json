{
  "schemaVersion": 1,
  "id": "agricraft",
  "version": "${version}",
  "name": "AgriCraft",
  "description": "${mod_description}",
  "authors": [
    "InfinityRaider",
    "Ketheroth",
    "AgriCraft contributors",
    "1.19.2 port contributors"
  ],
  "contact": {
    "homepage": "https://github.com/mweinbach/Mystcraft2/tree/main/mods/agricraft",
    "sources": "https://github.com/mweinbach/Mystcraft2",
    "issues": "https://github.com/mweinbach/Mystcraft2/issues"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.agricraft.agricraft.fabric.AgriCraftFabric"],
    "client": ["com.agricraft.agricraft.client.fabric.AgriCraftFabricClient"],
    "emi": ["com.agricraft.agricraft.compat.emi.AgriCraftEmiPlugin"],
    "jei_mod_plugin": ["com.agricraft.agricraft.compat.jei.AgriCraftJeiPlugin"],
    "rei_client": ["com.agricraft.agricraft.compat.rei.AgriCraftReiPlugin"],
    "jade": ["com.agricraft.agricraft.compat.jade.AgriCraftJadePlugin"],
    "modmenu": ["com.agricraft.agricraft.common.config.fabric.ModMenuConfig"]
  },
  "mixins": ["agricraft.fabric.mixins.json"],
  "accessWidener": "agricraft.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": ">=0.77.0",
    "minecraft": "1.19.2",
    "java": ">=17",
    "resourcefulconfig": ">=1.0.20"
  },
  "suggests": {
    "itemalchemy": "*",
    "emi": "*",
    "jade": "*",
    "wthit": "*",
    "modmenu": "*",
    "botania": "*"
  },
  "custom": {
    "waila:plugins": {
      "id": "agricraft:plugin",
      "initializer": "com.agricraft.agricraft.compat.fabric.wthit.AgriCraftWthitPlugin"
    }
  }
}
