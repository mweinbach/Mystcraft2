{
  "schemaVersion": 1,
  "id": "bigreactors",
  "version": "${version}",
  "name": "Extreme Reactors",
  "description": "${mod_description}",
  "authors": [
    "ZeroNoRyouki",
    "erogenousbeef",
    "1.19.2 port contributors"
  ],
  "contact": {
    "homepage": "https://github.com/ZeroNoRyouki/ExtremeReactors2",
    "sources": "https://github.com/mweinbach/Mystcraft2/tree/main/mods/extremereactors",
    "issues": "https://github.com/mweinbach/Mystcraft2/issues"
  },
  "icon": "logo.png",
  "license": "MIT",
