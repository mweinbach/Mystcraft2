{
  "schemaVersion": 1,
  "id": "jurassicraft",
  "version": "${version}",
  "name": "JurassiCraft Fabric Port",
  "description": "In-progress Fabric adaptation of JurassiCraft for Minecraft 1.19.2.",
  "environment": "*",
  "entrypoints": {
    "main": ["ports.jurassicraft.PortMod"],
    "client": ["ports.jurassicraft.FabricClient"],
    "jade": ["ports.jurassicraft.compat.jade.JurassicJadePlugin"],
    "emi": ["ports.jurassicraft.compat.emi.JurassicEmiPlugin"]
  },
  "mixins": ["jurassicraft-fence.mixins.json", "jurassicraft.vehicle.mixins.json", "jurassicraft-village.mixins.json", "jurassicraft-structures.mixins.json"],
  "license": "LicenseRef-Unknown",
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": ">=0.77.0",
    "minecraft": "1.19.2",
    "java": ">=17"
  }
}
