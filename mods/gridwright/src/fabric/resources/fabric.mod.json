{
  "schemaVersion": 1,
  "id": "gridwright",
  "version": "${version}",
  "name": "Gridwright",
  "description": "${mod_description}",
  "authors": [
    "1.19.2 port contributors"
  ],
  "contact": {
    "homepage": "https://github.com/mweinbach/Mystcraft2/tree/main/mods/gridwright",
    "sources": "https://github.com/mweinbach/Mystcraft2",
    "issues": "https://github.com/mweinbach/Mystcraft2/issues"
  },
  "license": "MIT",
  "icon": "assets/gridwright/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["ports.gridwright.fabric.GridwrightFabric"],
    "client": ["ports.gridwright.fabric.client.GridwrightFabricClient"],
    "jei_mod_plugin": ["ports.gridwright.compat.jei.GridwrightJeiPlugin"],
    "emi": ["ports.gridwright.compat.emi.GridwrightEmiPlugin"],
    "rei_client": ["ports.gridwright.compat.rei.GridwrightReiPlugin"]
  },
  "mixins": ["gridwright.fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": ">=0.77.0",
    "minecraft": "1.19.2",
    "java": ">=17"
  },
  "suggests": {
    "itemalchemy": "*",
    "jei": "*",
    "emi": "*",
    "roughlyenoughitems": "*"
  }
}
