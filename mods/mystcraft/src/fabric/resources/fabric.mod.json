{
  "schemaVersion": 1,
  "id": "mystcraft",
  "version": "${version}",
  "name": "Mystcraft",
  "description": "Classic Mystcraft development port for Minecraft 1.19.2: linking, descriptive books, Ages, writing and crystal portals. Full 1.12 parity remains in progress.",
  "authors": ["XCompWiz", "1.19.2 port contributors"],
  "contact": {
    "homepage": "https://github.com/mweinbach/Mystcraft2",
    "sources": "https://github.com/mweinbach/Mystcraft2",
    "issues": "https://github.com/mweinbach/Mystcraft2/issues"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/mystcraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["net.mystcraft.fabric.FabricMystcraft"],
    "client": ["net.mystcraft.fabric.FabricMystcraftClient"]
  },
  "mixins": ["mystcraft.fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": ">=0.77.0",
    "fluidphysics": ">=0.1.0",
    "minecraft": "1.19.2",
    "java": ">=17"
  }
}
