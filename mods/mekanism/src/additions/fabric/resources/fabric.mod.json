{
  "schemaVersion": 1,
  "id": "mekanismadditions",
  "version": "${version}",
  "name": "Mekanism: Additions",
  "description": "Additions module for Mekanism, containing plastic blocks, glow panels, obsidian TNT, baby mobs and balloons. The walkie-talkie is not included.",
  "authors": [
    "Aidancbrady",
    "Thommy101",
    "Thiakil",
    "pupnewfster",
    "dizzyd"
  ],
  "contact": {
    "homepage": "https://aidancbrady.com/mekanism/",
    "sources": "https://github.com/mweinbach/Mystcraft2/tree/main/mods/mekanism"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "mixins": [
    "mekanismadditions.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "ports.mekanism.additions.fabric.AdditionsFabricMod"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "1.19.2",
    "java": ">=17",
    "mekanism": "${version}"
  }
}
