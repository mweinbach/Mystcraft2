{
  "schemaVersion": 1,
  "id": "buildcraft",
  "version": "${mod_version}",
  "name": "BuildCraft",
  "description": "${mod_description} Ported from BuildCraft by SpaceToad, AlexIIL and the BuildCraft team (https://github.com/BuildCraft/BuildCraft).",
  "authors": ["SpaceToad", "AlexIIL", "the BuildCraft team", "1.19.2 port contributors"],
  "contact": {
    "homepage": "https://github.com/mweinbach/Mystcraft2/tree/main/mods/buildcraft",
    "sources": "https://github.com/mweinbach/Mystcraft2/tree/main/mods/buildcraft",
    "issues": "https://github.com/mweinbach/Mystcraft2/issues"
  },
  "license": "MPL-2.0",
  "icon": "assets/buildcraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["ports.buildcraft.fabric.FabricMod"],
    "client": ["ports.buildcraft.fabric.FabricClientMod"]
  },
  "mixins": ["buildcraft.mixins.json", "buildcraft.fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": ">=0.77.0",
    "team_reborn_energy": ">=2.3.0",
    "minecraft": "1.19.2",
    "java": ">=17"
  },
  "suggests": {
    "itemalchemy": "*"
  }
}
