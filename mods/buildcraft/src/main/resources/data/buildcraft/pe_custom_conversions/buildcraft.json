{
  "comment": "Generated by scripts/emc.py from mods/<port>/emc/policy.json. Explicit values for uncraftable buildcraft items and conversions for machine steps ProjectE cannot see; the FAKE|no_emc conversion never resolves, so excluded items get no EMC. Everything else is derived from recipes by ProjectE.",
  "groups": {
    "buildcraft_refine_light_fuel": {
      "comment": "The refinery's routes all yield half a bucket of light fuel per bucket of oil, so a bucket of light fuel is worth the oil from two buckets, returning one bucket. The lava and water that heat and cool it, and the by-products, are left out so that no route makes light fuel for less than its value.",
      "conversions": [
        {
          "output": "buildcraft:fuel_light_bucket",
          "ingredients": {
            "buildcraft:oil_bucket": 2,
            "minecraft:bucket": -1
          }
        }
      ]
    },
    "buildcraft_architect_table_records": {
      "comment": "The architect table records an area onto a blank template or blueprint and hands back the recorded one, so a recorded item is worth its blank. Transmutation never copies NBT, and a recorded item without its header acts as a blank one: the table records onto it again.",
      "conversions": [
        {
          "output": "buildcraft:blueprint_used",
          "ingredients": {
            "buildcraft:blueprint_clean": 1
          }
        },
        {
          "output": "buildcraft:schematic_single_used",
          "ingredients": {
            "buildcraft:schematic_single_clean": 1
          }
        },
        {
          "output": "buildcraft:template_used",
          "ingredients": {
            "buildcraft:template_clean": 1
          }
        }
      ]
    },
    "buildcraft_assemble_redstone_chipset": {
      "comment": "The assembly table makes a redstone chipset from a redstone dust and laser power (upstream's chipset assembly recipe). ProjectE and ItemAlchemy map no assembly recipes, so it is restated here; laser power is left unvalued, as engine fuel is.",
      "conversions": [
        {
          "output": "buildcraft:redstone_chipset",
          "ingredients": {
            "minecraft:redstone": 1
          }
        }
      ]
    },
    "buildcraft_assemble_ingot_chipsets": {
      "comment": "The assembly table makes iron and golden chipsets from a redstone dust, an ingot of their metal and laser power, which is left unvalued.",
      "conversions": [
        {
          "output": "buildcraft:gold_chipset",
          "ingredients": {
            "minecraft:redstone": 1,
            "minecraft:gold_ingot": 1
          }
        },
        {
          "output": "buildcraft:iron_chipset",
          "ingredients": {
            "minecraft:redstone": 1,
            "minecraft:iron_ingot": 1
          }
        }
      ]
    },
    "buildcraft_assemble_quartz_chipset": {
      "comment": "The assembly table makes a quartz chipset from a redstone dust, a nether quartz and laser power, which is left unvalued.",
      "conversions": [
        {
          "output": "buildcraft:quartz_chipset",
          "ingredients": {
            "minecraft:redstone": 1,
            "minecraft:quartz": 1
          }
        }
      ]
    },
    "buildcraft_assemble_diamond_chipset": {
      "comment": "The assembly table makes a diamond chipset from a redstone dust, a diamond and laser power, which is left unvalued.",
      "conversions": [
        {
          "output": "buildcraft:diamond_chipset",
          "ingredients": {
            "minecraft:redstone": 1,
            "minecraft:diamond": 1
          }
        }
      ]
    }
