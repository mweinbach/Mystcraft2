{
  "multipart": [
    {
      "when": {
        "down": "none"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_item_center_down"
      }
    },
    {
      "when": {
        "down": "connected"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_item_arm_down"
      }
    },
    {
      "when": {
        "down": "special"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_item_arm_down"
      }
    },
    {
      "when": {
        "up": "none"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_item_center_up"
      }
    },
    {
      "when": {
        "up": "connected"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_item_arm_up"
      }
    },
    {
      "when": {
        "up": "special"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_item_arm_up"
      }
    },
    {
      "when": {
        "north": "none"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_item_center_north"
      }
    },
    {
      "when": {
        "north": "connected"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_item_arm_north"
      }
    },
    {
      "when": {
        "north": "special"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_item_arm_north"
      }
    },
    {
      "when": {
        "south": "none"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_item_center_south"
      }
    },
    {
      "when": {
        "south": "connected"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_item_arm_south"
      }
    },
    {
      "when": {
        "south": "special"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_item_arm_south"
      }
    },
    {
      "when": {
        "west": "none"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_item_center_west"
      }
    },
    {
      "when": {
        "west": "connected"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_item_arm_west"
      }
    },
    {
      "when": {
        "west": "special"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_item_arm_west"
      }
    },
    {
      "when": {
        "east": "none"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_item_center_east"
      }
    },
    {
      "when": {
        "east": "connected"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_item_arm_east"
      }
    },
    {
      "when": {
        "east": "special"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_item_arm_east"
      }
    },
    {
      "when": {
        "direction": "north"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_rod"
      }
    },
    {
      "when": {
        "direction": "east"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_rod",
        "y": 90
      }
    },
    {
      "when": {
        "direction": "south"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_rod",
        "y": 180
      }
    },
    {
      "when": {
        "direction": "west"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_rod",
        "y": 270
      }
    },
    {
      "when": {
        "direction": "down"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_rod",
        "x": 90
      }
    },
    {
      "when": {
        "direction": "up"
      },
      "apply": {
        "model": "buildcraft:block/pipe/stripes_rod",
        "x": 270
      }
    }
  ]
}
